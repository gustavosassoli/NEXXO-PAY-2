# NEXO PAY - Variáveis de ambiente públicas

# VITE_WALLETCONNECT_PROJECT_ID: Project ID do WalletConnect Cloud para conexão móvel
VITE_WALLETCONNECT_PROJECT_ID="31d2dd4ad4b424bb58d9de171774869b"

# VITE_POLYGON_RPC_URL: RPC HTTPS para a rede Polygon PoS (opcional, padrão público da rede caso omitido)
VITE_POLYGON_RPC_URL="https://polygon-rpc.com"

# Backend (NUNCA use o prefixo VITE_ para estes segredos)
# Neon PostgreSQL: connection string com sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Segredo aleatório com no mínimo 32 bytes. Gere um valor exclusivo por ambiente.
NEXXO_JWT_SECRET="substitua-por-um-segredo-longo-e-aleatorio"

# URL pública usada na mensagem de autenticação assinada pela carteira.
NEXXO_APP_ORIGIN="http://localhost:3000"
